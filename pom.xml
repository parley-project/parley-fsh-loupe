<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- The Loupe debugging adapter for fsh (the FileSource Shell). Not part of fsh or of Parley. -->
	<groupId>us.bringardner</groupId>
	<artifactId>fsh-loupe</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<name>fsh-loupe</name>
	<description>A Loupe debugging adapter for fsh: runs a script under fsh's DebugContext and answers
		Loupe requests (breakpoints, steps, stack, variables, evaluate), so fsh-ide or any DAP client
		(through parley-loupe's bridge) can debug fsh scripts.</description>

	<url>https://github.com/parley-project/parley-fsh-loupe</url>
	<inceptionYear>2026</inceptionYear>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>tony-bringardner</id>
			<name>Tony Bringardner</name>
			<url>https://github.com/tony-bringardner</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/parley-project/parley-fsh-loupe.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/parley-project/parley-fsh-loupe.git</developerConnection>
		<url>https://github.com/parley-project/parley-fsh-loupe/tree/master</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>11</maven.compiler.release>
		<junit5.version>5.11.4</junit5.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit5.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Maven Central: mvn -Prelease clean deploy (sources, javadoc, GPG signatures, upload) -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.11.2</version>
						<configuration>
							<!-- Lenient so existing code releases cleanly; tighten to all,-missing later -->
							<doclint>none</doclint>
							<release>${maven.compiler.release}</release>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.7</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<!-- Passphrase comes from the MAVEN_GPG_PASSPHRASE environment variable -->
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<configuration>
							<!-- Matches the <server><id> in ~/.m2/settings.xml -->
							<publishingServerId>central</publishingServerId>
							<!-- false: you review and click Publish on central.sonatype.com -->
							<autoPublish>false</autoPublish>
							<deploymentName>${project.artifactId} ${project.version}</deploymentName>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<dependencies>
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>fsh</artifactId>
			<version>2.0.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-loupe</artifactId>
			<version>2.0.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
